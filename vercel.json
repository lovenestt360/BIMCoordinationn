{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app"
    },
    "email_bridge": {
      "root": "email-bridge/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/verify-email",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

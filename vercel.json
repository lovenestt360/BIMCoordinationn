{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app"
    },
    "email_bridge": {
      "root": "email-bridge/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/process-research/openai-test",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-research/finalize",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-research/dispatch",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-research/status",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-research",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/verify-email",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-leads",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/api/process-leads/status",
      "destination": {
        "service": "email_bridge"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/process-leads",
      "schedule": "0 4 * * *"
    }
  ]
}
